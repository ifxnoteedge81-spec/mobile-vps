# ==============================================================================
# KaryoOS Multi-AI & Server Environment Variables Template
# Copy these variables into your server environment (.env, Cloud Run, Render,
# Railway, VPS, or AI Studio Secrets). NEVER commit real API keys to Git.
# ==============================================================================

# --- 1. Google Gemini Free Key Pool (Auto-Rotated Round-Robin) ---
# AI Studio automatically injects GEMINI_API_KEY from Secrets.
GEMINI_API_KEY=""
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""
GEMINI_API_KEY_3=""
GEMINI_API_KEY_4=""
GEMINI_API_KEY_5=""
GEMINI_MODEL="gemini-4-hydrogen"

# --- 2. OpenRouter (1 Key -> Multi Free-Model Cascade) ---
OPENROUTER_API_KEY=""
OPENROUTER_MODELS="google/gemini-2.0-flash-exp:free,meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-chat-v3-0324:free,qwen/qwen-2.5-72b-instruct:free"

# --- 3. OpenAI (ChatGPT / GPT-4o / o-series) ---
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# --- 4. Anthropic (Claude) ---
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"

# --- 5. Groq (Ultra-Fast Llama / Mixtral) ---
GROQ_API_KEY=""
GROQ_MODEL="llama-3.3-70b-versatile"

# --- 6. DeepSeek ---
DEEPSEEK_API_KEY=""
DEEPSEEK_MODEL="deepseek-chat"

# --- 7. Mistral AI ---
MISTRAL_API_KEY=""
MISTRAL_MODEL="mistral-small-latest"

# --- 8. Any Custom OpenAI-Compatible AI (xAI Grok, Together, Ollama, vLLM, etc.) ---
CUSTOM_AI_NAME="Custom AI"
CUSTOM_AI_BASE_URL=""
CUSTOM_AI_API_KEY=""
CUSTOM_AI_MODEL=""

# --- 9. Provider Routing Priority ---
# Use AUTO to automatically rotate across all configured providers on 429/errors,
# or specify an order: GEMINI,OPENROUTER,OPENAI,ANTHROPIC,GROQ,DEEPSEEK,MISTRAL,CUSTOM
AI_PROVIDER_PRIORITY="AUTO"

# --- 10. Hosting & Build Configuration ---
APP_URL="MY_APP_URL"
VITE_SITE_MODE="workbench"
VITE_GITHUB_REPO=""
